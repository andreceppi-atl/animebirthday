# Database (Neon Postgres). Optional for local — app uses data/store.json when unset.
DATABASE_URL=

# Protects /api/ingest and /api/briefing/monthly cron endpoints
CRON_SECRET=dev-cron-secret-change-me

# ChartEx API (https://chartex.com/apidocs/dashboard) — App ID + App Token
CHARTEX_APP_ID=
CHARTEX_APP_TOKEN=

# Public feed confidence gates (defaults shown)
# CONFIDENT_MIN_FAVOURITES=500
# CONFIDENT_MIN_MOMENT_SIGNIFICANCE=50

# Monthly Claude SMS briefing (1st of month 16:00 UTC ≈ noon ET)
# ANTHROPIC_API_KEY=
# Twilio optional until you create an account — cron still generates the brief
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# BRIEFING_SMS_TO=+19147042663

# Optional HTML birthday table (Fandom wikitable) for extra coverage
# WIKI_BIRTHDAY_URL=https://example.fandom.com/wiki/Birthday_List

# Optional HTML moments table for extra JP media dates
# WIKI_MOMENTS_URL=https://example.fandom.com/wiki/Important_Dates

# Neon: after accepting marketplace terms, run:
#   npx vercel integration add neon -n animebirthday-db
#   npx vercel env pull .env.local

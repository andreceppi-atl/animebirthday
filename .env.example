# Database (Neon Postgres). Optional for local — app uses data/store.json when unset.
DATABASE_URL=

# Protects /api/ingest cron endpoint
CRON_SECRET=dev-cron-secret-change-me

# ChartEx API (https://chartex.com/apidocs/dashboard) — App ID + App Token
CHARTEX_APP_ID=
CHARTEX_APP_TOKEN=

# Optional HTML birthday table (Fandom wikitable) for extra coverage
# WIKI_BIRTHDAY_URL=https://example.fandom.com/wiki/Birthday_List

# Optional HTML moments table for extra JP media dates
# WIKI_MOMENTS_URL=https://example.fandom.com/wiki/Important_Dates
